        "name": "headline_size",
        "label": "Headline",
        "type": "number",
        "min": 14,
        "max": 60,
        "step": 1,
        "suffix": "px",
        "default": 26
      },
      {
        "name": "title_size",
        "label": "Name",
        "type": "number",
        "min": 12,
        "max": 32,
        "step": 1,
        "suffix": "px",
