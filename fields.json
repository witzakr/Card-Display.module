        "suffix": "px",
        "default": 5
      },
      {
        "name": "radius",
        "label": "Corner radius",
        "type": "number",
        "min": 0,
        "max": 30,
        "step": 1,
        "suffix": "px",
        "default": 8
      },
      {
        "name": "size",
        "label": "Text size",
        "type": "number",
        "min": 11,
        "max": 20,
        "step": 1,
        "suffix": "px",
